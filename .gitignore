# Dependencies — restorable exactly from package-lock.json, which IS committed.
/node_modules
/.pnp
.pnp.js

# Build output. `.next` is the dev server's; `.next-build` is the separate dist
# dir next.config.mjs uses so a production build never corrupts a running dev
# server (NEXT_DIST_DIR). Neither is a source of truth.
/.next/
/.next-build/
/out/
/build

# TypeScript incremental cache — regenerated on every tsc run.
*.tsbuildinfo

# Generated by Next on every build; not authored.
next-env.d.ts

# Secrets. None exist in this project today, and none are referenced by any
# code (the only process.env read is NEXT_DIST_DIR). This is a guard so that
# GA4, Meta Pixel and the GHL webhook keys cannot be committed by accident when
# they arrive.
.env
.env.local
.env*.local
.env.development.local
.env.test.local
.env.production.local

# Vercel CLI project linkage (project + org id). Machine-specific, and Vercel's
# own convention is to ignore it.
.vercel

# OS / editor noise
.DS_Store
Thumbs.db
*.pem

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Raw asset drops — NOT tracked. The delivered/used versions live under
# public/synergy, public/blog-gallery, public/services-gallery and
# public/carriers. These are the unprocessed client dumps and the space-named
# duplicates of the kebab-case folders (same bytes, different names).
/public/New folder/
/public/Insurance Carriers Logos/
/public/blog gallery/
/public/services gallery/
/public/*.zip
